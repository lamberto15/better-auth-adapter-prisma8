{
	"name": "better-auth-adapter-prisma8",
	"version": "0.5.1",
	"description": "Better Auth database adapter for Prisma 8 (Prisma Next, contract-first) — built from scratch against the db.orm runtime, not a port of the classic Prisma Client adapter.",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/lamberto15/better-auth-adapter-prisma8.git"
	},
	"bugs": {
		"url": "https://github.com/lamberto15/better-auth-adapter-prisma8/issues"
	},
	"homepage": "https://github.com/lamberto15/better-auth-adapter-prisma8#readme",
	"type": "module",
	"sideEffects": false,
	"main": "./dist/index.mjs",
	"module": "./dist/index.mjs",
	"types": "./dist/index.d.mts",
	"exports": {
		".": {
			"types": "./dist/index.d.mts",
			"default": "./dist/index.mjs"
		},
		"./package.json": "./package.json"
	},
	"files": [
		"dist",
		"src",
		"!src/**/*.test.ts",
		"!src/prisma-orm-postgres.d.ts",
		"LICENSE"
	],
	"keywords": [
		"better-auth",
		"prisma",
		"prisma-8",
		"prisma-next",
		"adapter",
		"database",
		"auth",
		"authentication",
		"postgresql",
		"typescript"
	],
	"engines": {
		"node": ">=22.0.0"
	},
	"packageManager": "pnpm@11.6.0",
	"scripts": {
		"build": "tsdown",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:offline": "vitest run --exclude \"**/official-adapter-suite.integration.test.ts\"",
		"test:coverage": "vitest run --coverage",
		"typecheck": "tsc --noEmit",
		"prepublishOnly": "pnpm run typecheck && pnpm run test:offline && pnpm run build",
		"changeset": "changeset",
		"version": "changeset version",
		"release": "pnpm run build && changeset publish"
	},
	"dependencies": {
		"@js-temporal/polyfill": "^0.5.1"
	},
	"peerDependencies": {
		"@better-auth/core": "^1.7.2",
		"@prisma/orm-postgres": "^8.0.0-rc.8",
		"typescript": "^5.6.0"
	},
	"peerDependenciesMeta": {
		"typescript": {
			"optional": true
		}
	},
	"devDependencies": {
		"@better-auth/core": "^1.7.2",
		"@better-auth/test-utils": "1.7.2",
		"@changesets/changelog-github": "^1.0.0",
		"@changesets/cli": "^3.0.1",
		"@prisma/orm-postgres": "8.0.0-rc.8",
		"@types/node": "^26.4.0",
		"@types/pg": "^8.23.1",
		"@vitest/coverage-v8": "^3.2.7",
		"better-auth": "1.7.2",
		"pg": "^8.23.0",
		"tsdown": "^0.22.14",
		"typescript": "^5.6.0",
		"vitest": "^3.2.7"
	},
	"author": "Lamby"
}
